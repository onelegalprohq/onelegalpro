# PF-011 Local Environment & Configuration
#
# These are the standardized local-development defaults for the PF-010 Docker
# Compose stack (see README.md, "Local development (PF-011)"). Every value
# below is safe to commit: non-secret, development-only, and meaningless
# outside a developer's own local Docker network. Copy this file to `.env`
# (never commit `.env` itself) and run `php artisan key:generate` locally.

APP_NAME=OneLegalPro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local-development-only PostgreSQL credentials. These match the `postgres`
# service defined in compose.yaml exactly, are reachable only from other
# containers on the internal "onelegalpro" Docker network, and are never
# valid or used outside this local Docker environment — never production
# credentials.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=onelegalpro
DB_USERNAME=onelegalpro
DB_PASSWORD=onelegalpro_dev_only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis is available via the `redis` Docker Compose service for future
# approved use. It is not the default cache/session/queue driver in PF-011
# (those remain the `database` driver above, per the approved PF-010/PF-011
# decision), but connection details are kept correct so Redis is reachable
# from the application when needed.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# The `log` mailer never sends mail — safe, non-sending local default.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@onelegalpro.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
